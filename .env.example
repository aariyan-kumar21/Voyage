# MongoDB Atlas connection string (found in Atlas dashboard under Connect > Drivers)
# Required for user accounts, auth, and trip data persistence
MONGODB_URI=your_mongodb_connection_string_here

# Google Gemini API key (from Google AI Studio - https://aistudio.google.com/)
# Primary AI model provider for itinerary planning and chat
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API key (from Groq Console - https://console.groq.com/)
# Secondary fallback AI provider if Gemini hits rate limits or is unavailable
GROQ_API_KEY=your_groq_api_key_here

# Secret used to sign session/auth tokens — use a long random string
JWT_SECRET=your_random_secret_string_here

# Optional alias for JWT_SECRET (supported by auth helper if JWT_SECRET is not set)
AUTH_SECRET=your_random_secret_string_here
